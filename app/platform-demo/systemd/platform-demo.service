[Unit]
Description=Platform Demo FastAPI Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=platform-demo
Group=platform-demo

WorkingDirectory=/opt/platform-demo

EnvironmentFile=-/etc/platform-demo/platform-demo.env

ExecStart=/opt/platform-demo/.venv/bin/uvicorn \
    main:app \
    --host 0.0.0.0 \
    --port 8080

Restart=on-failure
RestartSec=5

# Basic hardening. We'll revisit these as we get deeper into
# EC2 security and Linux operations.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target